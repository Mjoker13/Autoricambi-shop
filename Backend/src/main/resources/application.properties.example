server.port=8080
logging.level.root=INFO

#-------------------------
# Database
spring.datasource.url=jdbc:mysql://localhost:3306/auto_ricambi
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:changeme}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

#-------------------------
# JPA
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# DEV/DEMO: "create" ricrea le tabelle ad ogni avvio -> data.sql carica sempre dati freschi
# PRODUZIONE: cambiare in "validate" (schema gestito da migration tool)
spring.jpa.hibernate.ddl-auto=create

# Necessario per far girare data.sql DOPO che JPA ha creato le tabelle
spring.jpa.defer-datasource-initialization=true
spring.sql.init.mode=always

#-------------------------
# JWT
jwt.secret=${JWT_SECRET:change-this-to-a-random-secret-min-32-chars}
jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}
